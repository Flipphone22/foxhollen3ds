; Opt-in source splash bands with projected colour capture. No CPU vertices.
; Deliberate partial stage: three indirect offsets currently share one sample.
.fvec projection[4], view[3], bands[24], colors[8], uvscale[2], reflected[3]
.fvec fog_padding[50], fog_distance_scale
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0.xy
.out - texcoord0w outuv.z
.out outmask texcoord1
.out outfoam texcoord2
.out outview view
.out outquat normalquat
.proc main
    mova a0.x, v2.x
    mov r1.w, constants.y
    dp4 r1.x, bands[a0.x], v0
    dp4 r1.y, bands[a0.x+1], v0
    dp4 r1.z, bands[a0.x+2], v0
    dp4 r0.x, view[0], r1
    dp4 r0.y, view[1], r1
    dp4 r0.z, view[2], r1
    mov r0.w, constants.y
    ; Reuse the shared fog-only fragment-light owner. Positive view Z encodes
    ; eye depth without normalizing it or consuming a texture coordinate.
    mov outview.xyw, constants.x
    mul r3.x, fog_distance_scale.x, -r0.z
    add outview.z, constants.y, r3.x
    mov outquat, constants.xxxy
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    dp4 outuv.x, reflected[0], r0
    dp4 outuv.y, reflected[1], r0
    dp4 outuv.z, reflected[2], r0
    mov outuv.w, constants.y
    mova a0.x, v2.y
    mov outcolor, colors[a0.x]
    mul r2.xy, uvscale[0], v1
    mov outmask.x, r2.x
    add outmask.y, constants.y, -r2.y
    mov outmask.zw, constants.xxxy
    mul r2.xy, uvscale[1], v1
    mov outfoam.x, r2.x
    add outfoam.y, constants.y, -r2.y
    mov outfoam.zw, constants.xxxy
    end
.end
