; Optional native world-material entry in the shared material bank.
; PNMTX0 must equal the supplied world view transform. Actor bone blending
; cannot use this entry without a separate source PNMTX0 snapshot.
; UV0: base. UV1: source height fog. UV2: procedural distance fog.
; Source height fog interpolation/clamping remains per fragment.
.fvec view[3], projection[4], tint, uvscale[2], height_fog[2]
.fvec reserved[82], fog_distance_scale
.constf constants(0.0,1.0,0.0,0.0)
.bool height_fog_on, height_fog_layered
.out outpos position
.out outcolor color
.out outuv texcoord0
.out outheight texcoord1
.out outfog texcoord2
.out outview view
.out outquat normalquat
.proc main
    dp4 r0.x, view[0], v0
    dp4 r0.y, view[1], v0
    dp4 r0.z, view[2], v0
    mov r0.w, constants.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outcolor, tint, v1
    mul r1.xy, uvscale[0], v2
    add r1.xy, uvscale[0].zwzw, r1
    mov outuv.x, r1.x
    add outuv.y, constants.y, -r1.y
    mov outuv.zw, constants.xxxy
    ifu height_fog_on
        dp4 outheight.x, height_fog[0], r0
        dp4 r1.y, height_fog[1], r0
        mov outheight.y, r1.y
    .else
        mul r1.xy, uvscale[1], v3
        add r1.xy, uvscale[1].zwzw, r1
        mov outheight.x, r1.x
        add outheight.y, constants.y, -r1.y
    .end
    mov outheight.zw, constants.xxxy
    mul r3.x, fog_distance_scale.x, -r0.z
    mov r2.x, r3.x
    mov r2.y, constants.x
    ifu height_fog_layered
        dp4 r2.x, height_fog[0], r0
        dp4 r1.y, height_fog[1], r0
        mov r2.y, r1.y
    .end
    mov outfog.xy, r2
    mov outfog.zw, constants.xxxy
    ; The existing fog-only fragment-light owner frees UV2 for height fog.
    ; It consumes positive encoded eye depth, not a normalized view vector.
    mov outview.xyw, constants.x
    add outview.z, constants.y, r3.x
    mov outquat, constants.xxxy
    end
.end
