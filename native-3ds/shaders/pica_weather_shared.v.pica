; Original NewCloud triangle: shared live 20-shape pool plus centre/scale.
; 11 instances per batch, no streamed vertices or geometry shader.
.fvec view[3], projection[4], shapes[3], uvs[3], tint, particles[80], fog_distance_scale
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0
.out outfog texcoord2
.proc main
    mova a0.x, v0.x
    mov r0, particles[a0.x]
    mova a0.y, v0.y
    mul r2.xyz, shapes[a0.y], r0.w
    add r2.xyz, r2, r0
    mov r2.w, constants.y
    dp4 r3.x, view[0], r2
    dp4 r3.y, view[1], r2
    dp4 r3.z, view[2], r2
    mov r3.w, constants.y
    dp4 r4.x, projection[0], r3
    dp4 r4.y, projection[1], r3
    dp4 r4.z, projection[2], r3
    dp4 r4.w, projection[3], r3
    mov outpos.x, r4.y
    mov outpos.y, -r4.x
    mov outpos.zw, r4
    mov outcolor, tint
    mova a0.y, v0.y
    mov outuv, uvs[a0.y]
    mul outfog.x, fog_distance_scale.x, -r3.z
    mov outfog.yzw, constants.xxxy
    end
.end
