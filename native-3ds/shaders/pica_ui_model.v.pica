; Native UI models: resident skinning and direct UV arithmetic. Same c0..95
; ABI/output registers as the scene program; no fur/specular/lighting branches.
.fvec view[3], projection[4], tint, uvscale[2], bones[66], decode
.fvec ambient, light_position[8], light_color[8], fog_distance_scale
.constf constants(0.0,1.0,0.000000001,0.5)
.out outpos position
.out outcolor color
.out outuv texcoord0.xy
.out - texcoord0w outuv.z
.out outsecond texcoord1
.out outview view
.out outquat normalquat
.out outfog texcoord2
.proc main
    mul r4.xyz, decode.x, v0
    add r4.xyz, r4, v5
    mov r4.w, constants.y
    mova a0.x, v4.x
    dp4 r5.x, bones[a0.x], r4
    dp4 r5.y, bones[a0.x+1], r4
    dp4 r5.z, bones[a0.x+2], r4
    cmp v4.x, ne, ne, v4.y
    ifc cmp.x
        mova a0.x, v4.y
        dp4 r6.x, bones[a0.x], r4
        dp4 r6.y, bones[a0.x+1], r4
        dp4 r6.z, bones[a0.x+2], r4
        mul r7.x, decode.z, v4.z
        add r7.y, constants.y, -r7.x
        mul r5.xyz, r5, r7.x
        mad r5.xyz, r6, r7.y, r5
    .end
    mov r5.w, constants.y
    dp4 r0.x, view[0], r5
    dp4 r0.y, view[1], r5
    dp4 r0.z, view[2], r5
    mov r0.w, constants.y
    mul r2, decode.y, v1
    mul outcolor, tint, r2
    mov outview, -r0
    mov outquat, constants.xxxy
    mov outfog.yzw, constants.xxxy
    mul outfog.x, fog_distance_scale.x, -r0.z
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul r1.xy, uvscale[0], v2
    add r1.xy, uvscale[0].zwzw, r1
    mov outuv.x, r1.x
    add outuv.y, constants.y, -r1.y
    mov outuv.zw, constants.y
    mul r1.xy, uvscale[1], v2
    add r1.xy, uvscale[1].zwzw, r1
    mov outsecond.x, r1.x
    add outsecond.y, constants.y, -r1.y
    mov outsecond.zw, constants.xxxy
    end
.end
