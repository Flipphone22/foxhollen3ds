.gsh point c0
.fvec view[3], projection[4], templates[8], shapes[4], fade, uv_scale, reflected[3]
.bool dynamic_quad
.constf narrow(0.125,8.0,32768.0,65536.0)
.constf constants(0.0,1.0,2.5,256.0)
.constf ordinal(0.0,1.0,2.0,3.0)
.constf fold(4.0,0.5,2.0,0.25)
; Original angleToVec2 polynomial, scaled by powers of 32768 to avoid F24 underflow.
.constf sine(0.7853942513465881,-0.08071397244930267,0.002427086699754,1.0)
.constf cosine(-0.3084242641925812,0.01584991253912449,-0.00031887899967841804,1.5)
 .constf corner0(0.0,0.0,0.0,0.0)
.constf corner1(1.0,1.0,0.0,0.0)
.constf corner2(2.0,1.0,1.0,0.0)
.constf corner3(3.0,0.0,1.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord1
.out outfog texcoord2
.out outreflection texcoord0
.entry main
.proc main
    mov r0, v0
    mov r1, v1
    mov r3, v2
    mul r4, uv_scale.xyxy, v3
    mov r2.z, r1.w
    ; Evaluate yaw, pitch and phase together; fold each to [-1,1).
    mul r11.xyz, fold.x, r1
    add r13.xyz, fold.y, r11
    flr r13.xyz, r13
    add r11.xyz, r11, -r13
    mul r11.xyz, fold.z, r11
    mul r12.xyz, r11, r11
    mul r14.xyz, sine.z, r12
    add r14.xyz, sine.y, r14
    mul r14.xyz, r14, r12
    add r14.xyz, sine.x, r14
    mul r14.xyz, r14, r11
    mul r15.xyz, cosine.z, r12
    add r15.xyz, cosine.y, r15
    mul r15.xyz, r15, r12
    add r15.xyz, cosine.x, r15
    mul r15.xyz, r15, r12
    add r15.xyz, sine.w, r15
    ; Wrap quadrant 4 to 0, then swap sine/cosine in odd quadrants.
    mul r11.xyz, fold.w, r13
    flr r11.xyz, r11
    mul r11.xyz, fold.x, r11
    add r13.xyz, r13, -r11
    mul r11.xyz, fold.y, r13
    flr r11.xyz, r11
    mul r11.xyz, fold.z, r11
    add r11.xyz, r13, -r11
    add r12.xyz, r15, -r14
    mul r12.xyz, r12, r11
    add r14.xyz, r14, r12
    add r15.xyz, r15, -r12
    ; Quadrant signs: sine negative at 2/3, cosine negative at 1/2.
    sge r11.xyz, r13, fold.z
    mul r11.xyz, fold.z, r11
    add r11.xyz, sine.w, -r11
    mul r14.xyz, r14, r11
    add r11.xyz, -cosine.w, r13
    max r11.xyz, r11, -r11
    slt r11.xyz, r11, sine.w
    mul r11.xyz, fold.z, r11
    add r11.xyz, sine.w, -r11
    mul r15.xyz, r15, r11
    mov r1.x, r15.x
    mov r1.y, r14.x
    mov r1.z, r15.y
    mov r1.w, r14.y
    mov r2.x, r14.z
    mov r2.y, r15.z
    ; Unrotated X, Y and Z basis, then source phase rotation in XY.
    mov r5.x, r1.x
    mov r5.y, constants.x
    mov r5.z, -r1.y
    mul r6.x, r1.y, r1.w
    mov r6.y, r1.z
    mul r6.z, r1.x, r1.w
    mul r7.x, r1.y, r1.z
    mov r7.y, -r1.w
    mul r7.z, r1.x, r1.z
    mul r8.xyz, r5, r2.y
    mad r8.xyz, r6, r2.x, r8
    mul r9.xyz, r6, r2.y
    mad r9.xyz, r5, -r2.x, r9
    mul r8.xyz, r8, r0.w
    mul r9.xyz, r9, r0.w
    mul r7.xyz, r7, r0.w
    mov r0.w, constants.y
    ; Local depth plane also lets each corner reproduce the prefix alpha fade.
    dp3 r10.x, view[2], r8
    dp3 r10.y, view[2], r9
    dp3 r10.z, view[2], r7
    dp4 r10.w, view[2], r0
    ; Select a base quad and immutable shape transform once per instance.
    mul r11.x, narrow.x, r2.z
    flr r11.x, r11.x
    mova a0.x, r11.x
    mov r15, shapes[a0.x]
    mul r11.x, narrow.y, r11.x
    add r2.z, r2.z, -r11.x
    rcp r2.w, narrow.w
    mov r5, corner0
    setemit 0
    call emit_corner
    mov r5, corner1
    setemit 1
    call emit_corner
    mov r5, corner2
    setemit 2, prim
    call emit_corner
    mov r5, corner3
    setemit 1, inv prim
    call emit_corner
    end
.end
.proc emit_corner
    ifu dynamic_quad
        cmp ordinal.x, eq, eq, r5.x
        ifc cmp.x
            mov r11.xyz, v4
        .else
            cmp ordinal.y, eq, eq, r5.x
            ifc cmp.x
                mov r11.x, v4.w
                mov r11.yz, v5.xxy
            .else
                cmp ordinal.z, eq, eq, r5.x
                ifc cmp.x
                    mov r11.xy, v5.zw
                    mov r11.z, v6.x
                .else
                    mov r11.xyz, v6.yzw
                .end
            .end
        .end
    .else
    add r11.x, r2.z, r5.x
    mova a0.x, r11.x
    mov r11, templates[a0.x]
    ; Swap X/Z only for shape2, scale, then reproduce signed-short narrowing.
    add r12.xyz, r11.zyx, -r11
    mad r11.xyz, r15.w, r12, r11
    mul r11.xyz, r15, r11
    add r12.xyz, narrow.z, r11
    mul r12.xyz, r12, r2.w
    flr r12.xyz, r12
    mul r12.xyz, narrow.w, r12
    add r11.xyz, r11, -r12
    .end
    mad r12.xyz, r8, r11.x, r0
    mad r12.xyz, r9, r11.y, r12
    mad r12.xyz, r7, r11.z, r12
    mov r12.w, constants.y
    ; Prefix alpha is updated once per emitted corner, including signed truncation.
    dp3 r13.x, r11, r10
    add r13.x, r13.x, r10.w
    cmp fade.x, lt, lt, r13.x
    ifc cmp.x
        add r13.x, -constants.z, -r13.x
        mul r13.x, r13.x, r3.w
        mul r13.x, fade.y, r13.x
        max r14.x, r13.x, -r13.x
        flr r14.x, r14.x
        cmp constants.x, gt, gt, r13.x
        ifc cmp.x
            mov r14.x, -r14.x
        .end
        mov r3.w, r14.x
    .end
    ; Color narrowing must not overwrite the running signed alpha.
    mov r14, r3
    mul r13.x, fade.w, r3.w
    flr r13.x, r13.x
    mad r14.w, r13.x, -constants.w, r3.w
    mul outcolor, fade.z, r14
    dp4 r11.x, view[0], r12
    dp4 r11.y, view[1], r12
    dp4 r11.z, view[2], r12
    mov r11.w, constants.y
    dp4 r1.x, projection[0], r11
    dp4 r1.y, projection[1], r11
    dp4 r1.z, projection[2], r11
    dp4 r1.w, projection[3], r11
    mov outpos.x, r1.y
    mov outpos.y, -r1.x
    mov outpos.zw, r1
    add r13.xy, r4.zwzw, -r4
    mad r13.xy, r5.yzyz, r13, r4
    add r13.y, constants.y, -r13.y
    mov r13.zw, constants.xxxy
    mov outuv, r13
    ; U is normalized linear eye depth; V is unused by the fog LUT.
    mul outfog, uv_scale.zzww, -r11.zzzz
    ; Source TEXMTX2 is camera-light flip-Y matrix * current view.
    ; r11 already holds that view transform. Keep homogeneous XYZ for
    ; sampler 0's projective divide; sampler 1 retains ordinary particle UVs.
    dp4 outreflection.x, reflected[0], r11
    dp4 outreflection.y, reflected[1], r11
    dp4 outreflection.z, reflected[2], r11
    mov outreflection.w, constants.y
    emit
.end
