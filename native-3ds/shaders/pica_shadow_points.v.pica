; One source triangle per vertex invocation. PICA retains source group/cell
; bounds, computes face/query admission once, and transforms all three points.
.fvec view[3], projection[4], shadow_uv[2], shadow_ramp, fog_distance_scale
.fvec receiver_light, query_min, query_max, collision_offset
.constf constants(0.0,1.0,3.0,65536.0)
.constf narrow(32768.0,0.0,0.0,0.0)
.out clip0 position
.out attributes0 color
.out clip1 texcoord0
.out attributes1 texcoord1
.out clip2 view
.out attributes2 normalquat
.out admission texcoord2
.proc main
    mov r8, v0
    mov r9, v1
    mov r10, v2
    add r8.y, collision_offset.x, r8.y
    add r9.y, collision_offset.x, r9.y
    add r10.y, collision_offset.x, r10.y
    ; Original query bounds use unwrapped coordinates, but face normals and
    ; emitted positions use signed16 TrackTriangle coordinates.
    min r4.xyz, r8, r9
    min r4.xyz, r4, r10
    max r5.xyz, r8, r9
    max r5.xyz, r5, r10
    mov r6, v3
    mov r7, v4
    add r6.y, collision_offset.x, r6.y
    add r7.y, collision_offset.x, r7.y
    max r4.xyz, r4, r6
    min r5.xyz, r5, r7
    ; Do not reject inverted limits here. A wide query can intersect both
    ; a moved triangle and its original, disjoint authored constraint.
    sge r6.xyz, r5, query_min
    sge r7.xyz, query_max, r4
    min r6.xyz, r6, r7
    dp3 r2.z, constants.yyy, r6
    mov r2.w, constants.y
    cmp constants.z, gt, gt, r2.z
    ifc cmp.x
        mov r2.w, constants.x
    .end
    mov r4.x, r8.y
    mov r4.y, r9.y
    mov r4.z, r10.y
    sge r5.xyz, r4, narrow.x
    slt r6.xyz, r4, -narrow.x
    add r5.xyz, r5, -r6
    mul r5.xyz, constants.w, r5
    add r4.xyz, r4, -r5
    mov r8.y, r4.x
    mov r9.y, r4.y
    mov r10.y, r4.z
    add r4.xyz, r8, -r9
    add r5.xyz, r9, -r10
    mul r6.xyz, r4.yzx, r5.zxy
    mul r7.xyz, r4.zxy, r5.yzx
    add r6.xyz, r6, -r7
    dp3 r2.x, receiver_light, r6
    cmp constants.x, gt, gt, r2.x
    ifc cmp.x
        mov r2.w, constants.x
    .end
    dp3 r2.y, r6, r6
    cmp constants.x, ge, ge, r2.y
    ifc cmp.x
        mov r2.w, constants.x
    .end
    cmp constants.x, lt, lt, r2.w
    ifc cmp.x
    mov r1, r8
    mov r1.w, constants.y
    dp4 r0.x, view[0], r1
    dp4 r0.y, view[1], r1
    dp4 r0.z, view[2], r1
    mov r0.w, constants.y
    dp4 r3.x, projection[0], r0
    dp4 r3.y, projection[1], r0
    dp4 r3.z, projection[2], r0
    dp4 r3.w, projection[3], r0
    dp4 r4.x, shadow_uv[0], r1
    dp4 r4.y, shadow_uv[1], r1
    dp4 r4.z, shadow_ramp, r1
    mul r4.w, fog_distance_scale.x, -r0.z
    mov clip0, r3
    mov attributes0, r4
    mov r1, r9
    mov r1.w, constants.y
    dp4 r0.x, view[0], r1
    dp4 r0.y, view[1], r1
    dp4 r0.z, view[2], r1
    mov r0.w, constants.y
    dp4 r3.x, projection[0], r0
    dp4 r3.y, projection[1], r0
    dp4 r3.z, projection[2], r0
    dp4 r3.w, projection[3], r0
    dp4 r4.x, shadow_uv[0], r1
    dp4 r4.y, shadow_uv[1], r1
    dp4 r4.z, shadow_ramp, r1
    mul r4.w, fog_distance_scale.x, -r0.z
    mov clip1, r3
    mov attributes1, r4
    mov r1, r10
    mov r1.w, constants.y
    dp4 r0.x, view[0], r1
    dp4 r0.y, view[1], r1
    dp4 r0.z, view[2], r1
    mov r0.w, constants.y
    dp4 r3.x, projection[0], r0
    dp4 r3.y, projection[1], r0
    dp4 r3.z, projection[2], r0
    dp4 r3.w, projection[3], r0
    dp4 r4.x, shadow_uv[0], r1
    dp4 r4.y, shadow_uv[1], r1
    dp4 r4.z, shadow_ramp, r1
    mul r4.w, fog_distance_scale.x, -r0.z
    mov clip2, r3
    mov attributes2, r4
    .else
        mov clip0, constants.xxxx
        mov attributes0, constants.xxxx
        mov clip1, constants.xxxx
        mov attributes1, constants.xxxx
        mov clip2, constants.xxxx
        mov attributes2, constants.xxxx
    .end
    mov admission, r2.wwww
    end
.end
