; Native static world: two independent UVs, no character skin/light work.
; Full output writes follow pinned Melee's hardware initialization policy.
.fvec view[3], projection[4], tint, uvscale, secondscale, falloffscale, depthscale
.bool falloff_enabled
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0
.out outsecond texcoord1
.out outview view
.out outquat normalquat
.out outdepth texcoord2
.proc main
    dp4 r0.x, view[0], v0
    dp4 r0.y, view[1], v0
    dp4 r0.z, view[2], v0
    mov r0.w, constants.y
    mov outview, -r0
    mov outquat, constants.xxxy
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outcolor, tint, v1
    mul r1.xy, uvscale, v2
    add r1.xy, uvscale.zw, r1
    mov outuv.x, r1.x
    add outuv.y, constants.y, -r1.y
    mov outuv.zw, constants.xxxy
    mul r2.xy, secondscale, v3
    add r2.xy, secondscale.zw, r2
    add r2.y, constants.y, -r2.y
    mov r2.zw, constants.xxxy
    mov r3, constants.xxxy
    ifu falloff_enabled
        mul r2.xy, falloffscale, r0
        add r2.xy, falloffscale.zw, r2
        mul r3.x, depthscale.x, r0.z
        add r3.x, depthscale.y, r3.x
        mov r3.y, depthscale.w
    .end
    mov outsecond, r2
    mov outdepth, r3
    end
.end
