; Source mode-0 32x32 diffuse map: original live light count, GPU-only lighting.
; Persistent original hemisphere mesh: v0=clipXY, v1=source normalXYZ.
; Light positions follow modelLightStruct_loadDiffuseGXLight, including the
; model-relative view offset. Do not normalize authored corner normals.
; c0=ambient RGB (white when source channel has zero lights).
; c1..8=GX view-space positions, c9..16=source diffuse RGB.
; Inactive uniforms may contain another owner's values: boolean gates isolate them.
.fvec ambient, light_position[8], light_color[8]
.bool light0_active, light1_active, light2_active, light3_active, light4_active, light5_active, light6_active, light7_active
.constf constants(0.0,1.0,2.0,0.00000001)
.out outpos position
.out outcolor color
.proc main
    mov outpos.xy, v0
    mov outpos.zw, constants.xxxy
    mov r3.xy, -v1
    mov r3.zw, constants.zzxx
    mov r0, ambient
    ifu light0_active
        add r1.xyz, light_position[0], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[0], r0
    .end
    ifu light1_active
        add r1.xyz, light_position[1], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[1], r0
    .end
    ifu light2_active
        add r1.xyz, light_position[2], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[2], r0
    .end
    ifu light3_active
        add r1.xyz, light_position[3], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[3], r0
    .end
    ifu light4_active
        add r1.xyz, light_position[4], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[4], r0
    .end
    ifu light5_active
        add r1.xyz, light_position[5], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[5], r0
    .end
    ifu light6_active
        add r1.xyz, light_position[6], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[6], r0
    .end
    ifu light7_active
        add r1.xyz, light_position[7], r3
        dp3 r1.w, r1, r1
        max r1.w, constants.w, r1.w
        rsq r1.w, r1.w
        mul r1.xyz, r1, r1.w
        dp3 r2.x, r1, v1
        max r2.x, constants.x, r2.x
        mad r0.xyz, r2.x, light_color[7], r0
    .end
    max r0.xyz, constants.x, r0
    min outcolor.xyz, constants.y, r0
    mov outcolor.w, constants.y
    end
.end
