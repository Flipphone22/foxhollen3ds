; Replacement renderer: world position/color only. All declared outputs written.
.fvec view[3], projection[4], tint
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.proc main
    dp4 r0.x, view[0], v0
    dp4 r0.y, view[1], v0
    dp4 r0.z, view[2], v0
    mov r0.w, constants.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outcolor, tint, v1
    end
.end
