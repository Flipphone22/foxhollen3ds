; Immutable source ring. Eight live band matrices/alphas; no CPU vertex stream.
.fvec projection[4], view[3], bands[24], colors[8], uvscale[2]
.fvec fog_padding[53], fog_distance_scale
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0
.out outsecond texcoord1
.out outfog texcoord2
.proc main
    mova a0.x, v2.x
    mov r1.w, constants.y
    dp4 r1.x, bands[a0.x], v0
    dp4 r1.y, bands[a0.x+1], v0
    dp4 r1.z, bands[a0.x+2], v0
    dp4 r0.x, view[0], r1
    dp4 r0.y, view[1], r1
    dp4 r0.z, view[2], r1
    mov r0.w, constants.y
    mov outfog.yzw, constants.xxxy
    mul outfog.x, fog_distance_scale.x, -r0.z
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mova a0.x, v2.y
    mul r2.xy, uvscale[0], v1
    mov outcolor, colors[a0.x]
    mov outuv.x, r2.x
    add outuv.y, constants.y, -r2.y
    mov outuv.zw, constants.xxxy
    mul r2.xy, uvscale[1], v1
    mov outsecond.x, r2.x
    add outsecond.y, constants.y, -r2.y
    mov outsecond.zw, constants.xxxy
    end
.end
