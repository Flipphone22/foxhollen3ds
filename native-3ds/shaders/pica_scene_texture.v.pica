; Native world texture stage: persistent position/color/UV buffers.
.fvec view[3], projection[4], tint, uvscale[2]
.constf constants(0.0,1.0,0.0,0.0)
.out outpos position
.out outcolor color
.out outuv texcoord0
.out outsecond texcoord1
.proc main
    dp4 r0.x, view[0], v0
    dp4 r0.y, view[1], v0
    dp4 r0.z, view[2], v0
    mov r0.w, constants.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mul outcolor, tint, v1
    mul r1.xy, uvscale[0], v2
    add r1.xy, uvscale[0].zwzw, r1
    mov outuv.x, r1.x
    add outuv.y, constants.y, -r1.y
    mov outuv.zw, constants.xxxy
    mul r1.xy, uvscale[1], v3
    add r1.xy, uvscale[1].zwzw, r1
    mov outsecond.x, r1.x
    add outsecond.y, constants.y, -r1.y
    mov outsecond.zw, constants.xxxy
    end
.end
